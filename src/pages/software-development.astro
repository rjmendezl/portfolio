---
import Header from "../components/Header.astro";
import Project from "../components/Project.astro";
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";
import "../styles/styles.css";

const projects = [
  {
    title:
      "Data Recording System for Basílica Nuestra Señora de Guadalupe, La Ceiba Church",
    desc: [
      "Developed a full-stack information management system to centralize and manage parish records through a secure web application",
      "Designed and implemented features for data management, search, visualization, and user authentication",
      "Containerized the application with Docker to simplify deployment and maintenance",
    ],
    tech: ["Go", "PocketBase", "Next.js", "Docker"],
  },
  {
    title: "Articles Web App",
    desc: [
      "Joined a team of interns guided by professional developers to build a full featured PHP-Laravel web app from scratch",
      "Implemented backend features, APIs, and database functionality",
      "Implemented UI with responsive design",
    ],
    tech: ["PHP Laravel", "Vue.js", "PostgreSQL", "Jenkins", "Docker"],
  },
];

const mdm_projects = [
  {
    title: "MDM API",
    desc: [
      "Developed backend services in Go for the core MDM platform",
      "Designed and implemented REST APIs for managing people, organizations, addresses, specialties, and other master data entities",
      "Built event-driven processing pipelines using NATS JetStream and Kafka",
      "Optimized ClickHouse queries and Elasticsearch indexing to improve search performance and data retrieval",
      "Implemented automated testing, debugging, and performance improvements for high-volume data processing",
    ],
    tech: [
      "Go",
      "Clickhouse",
      "PostgreSQL",
      "Redis",
      "ElasticSearch",
      "Kafka",
      "NATS",
      "Docker",
      "Kubernetes",
      "Jenkins",
    ],
  },
  {
    title: "MDM Admin",
    desc: [
      "Led the development of an administrative web application for managing the MDM platform",
      "Designed and implemented features for data management, validation, and operational workflows",
      "Integrated the admin panel with backend APIs and authentication services",
    ],
    tech: [
      "PHP Laravel",
      "Filament",
      "PostgreSQL",
      "Redis",
      "Docker",
      "Kubernetes",
      "Jenkins",
    ],
  },
  {
    title: "ListMatch",
    desc: [
      "Developed features for a distributed entity resolution service that matches incoming records against master data using fuzzy search",
      "Enhanced worker pipelines responsible for ingesting, searching, deduplicating, and exporting matched records",
      "Improved Elasticsearch-based matching logic and optimized distributed processing workflows",
    ],
    tech: [
      "Go",
      "ElasticSearch",
      "PostgreSQL",
      "NATS",
      "Docker",
      "Kubernetes",
      "Jenkins",
    ],
  },
  {
    title: "Kosmos",
    desc: [
      "Contributed to a MDM integration platform responsible for synchronizing data from external systems",
      "Developed import/export workflows and source adapters for integrating third-party data into the MDM ecosystem",
      "Worked on background workers, APIs, and messaging infrastructure supporting large-scale data synchronization",
    ],
    tech: ["Go", "PostgreSQL", "NATS", "Docker", "Kubernetes"],
  },
];
---

<!doctype html>
<html>
  <Header title="Software Development | Ricardo Méndez" />
  <body>
    <div class="content">
      <Sidebar selectedItem="software-development" />
      <nav class="main">
        <div class="container">
          <div class="back-nav-container">
            <a href="/" class="back-nav-button w-inline-block"
              ><img
                src="/assets/back.svg"
                loading="lazy"
                alt=""
                class="back-nav-img"
              />
              <div>Back</div></a
            >
          </div>
          <div class="content-container">
            <h1>Software Development</h1>
            <section class="items-container">
              <div class="resouce-items">
                {
                  projects.map((project) => (
                    <Project
                      title={project.title}
                      desc={project.desc}
                      tech={project.tech}
                    />
                  ))
                }
              </div>
            </section>
          </div>
          <div class="content-container">
            <h3>Master Data Management</h3>
            <p>
              Worked on multiple services within Internet Brands' Master Data
              Management (MDM) platform, building data integration, entity
              resolution, and administration tools used to consolidate and
              manage millions of records across multiple data sources:
            </p>
            <section class="items-container">
              <div class="resouce-items">
                {
                  mdm_projects.map((project) => (
                    <Project
                      title={project.title}
                      desc={project.desc}
                      tech={project.tech}
                    />
                  ))
                }
              </div>
            </section>
          </div>
        </div>
        <Footer />
      </nav>
    </div>

    <!--[if lte IE 9]><script src="//cdnjs.cloudflare.com/ajax/libs/placeholders/3.0.2/placeholders.min.js"></script><![endif]-->
  </body>
</html>
